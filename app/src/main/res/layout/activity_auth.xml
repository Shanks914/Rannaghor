<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/buttonAuthBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/textAuthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome to Rannaghor"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/red_hat_display" />

        <TextView
            android:id="@+id/textAuthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Log in to plan meals and save your favourites."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editAuthEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search_box"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:id="@+id/textVerifiedEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/editAuthCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center"
            android:hint="6-digit email code"
            android:inputType="number"
            android:maxLength="6"
            android:letterSpacing="0.25"
            android:visibility="gone"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAuthPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_box"
            android:hint="Password (at least 6 characters)"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary"
            android:visibility="visible">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAuthConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_box"
            android:hint="Confirm password"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAuthConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textAuthStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/buttonAuthPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_rounded_button"
            android:gravity="center"
            android:text="Log in"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonAuthForgot"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Forgot password?"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonAuthResendCode"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Resend code"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/buttonAuthGoogle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center"
            android:text="Continue with Google"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonAuthMode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Create an account"
            android:textColor="@color/primary"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
