<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/previous_step" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Shopping list"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonShareList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_list"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:padding="4dp">

        <EditText
            android:id="@+id/editShoppingItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Add an item…"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/buttonAddItem"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rounded_button"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/add_item" />
    </LinearLayout>

    <TextView
        android:id="@+id/textSelectedWeek"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:clickable="true"
        android:drawableStart="@drawable/ic_calendar"
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:contentDescription="Select a date range for planned meals" />

    <TextView
        android:id="@+id/buttonGenerateFromPlan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_rounded_button"
        android:gravity="center"
        android:text="@string/generate_shopping_list"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerShopping"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
