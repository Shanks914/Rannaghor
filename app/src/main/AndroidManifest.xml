<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rannaghor">

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.detail.RecipeDetailActivity" android:exported="false" />
        <activity android:name=".ui.favorites.FavoritesActivity" android:exported="false" />
        <activity android:name=".ui.planner.PlannerActivity" android:exported="false" />
        <activity android:name=".ui.shopping.ShoppingListActivity" android:exported="false" />
        <activity android:name=".ui.cooking.CookingActivity" android:exported="false" />

        <service
            android:name=".service.CookingTimerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's cooking step timer running while the app is in the background." />
        </service>

        <receiver
            android:name=".receiver.TimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sadat.rannaghor.TIMER_FINISHED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".provider.ShoppingListProvider"
            android:authorities="com.sadat.rannaghor.provider.shopping"
            android:exported="false" />

    </application>
</manifest>
